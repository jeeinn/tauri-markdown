{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TauriMarkdown",
  "version": "0.2.0",
  "identifier": "com.jeeinn.tauri-markdown",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tauri Markdown",
        "width": 1000,
        "height": 800,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline' http://asset.localhost",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' http://asset.localhost",
        "connect-src": "'self' http://ipc.localhost ws://localhost:1420"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["**", "$DOCUMENT/**", "$DESKTOP/**", "$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "jeeinn",
    "shortDescription": "A local markdown tool",
    "longDescription": "A local markdown tool made by tauri + vditor",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "frameworks": [],
      "signingIdentity": null,
      "entitlements": null,
      "providerShortName": null,
      "exceptionDomain": ""
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2/capabilities",
  "identifier": "default",
  "description": "Default capabilities for the markdown editor app",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": ["**", "$DOCUMENT/**", "$DESKTOP/**", "$HOME/**"]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "core:path:allow-dirname",
    "core:path:allow-join",
    "core:path:allow-normalize",
    "core:window:allow-set-title",
    "store:default",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}

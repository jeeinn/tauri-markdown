{
  "$schema": "https://schema.tauri.app/config/2/capabilities",
  "identifier": "default",
  "description": "Default capabilities for the markdown editor app",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": ["**"]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "store:default"
  ]
}
